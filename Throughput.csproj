<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- Low-memory GC: workstation, non-concurrent, and return freed segments to
         the OS instead of retaining them. Suits a lightweight always-on tray app. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>

    <!-- Assembly Information -->
    <AssemblyName>Throughput</AssemblyName>
    <RootNamespace>Throughput</RootNamespace>
    <Version>3.1.4</Version>
    <Authors>Hakkan</Authors>
    <Company></Company>
    <Product>Throughput</Product>
    <Description>Real-time network speed monitor with on-demand bandwidth testing for Windows</Description>
    <Copyright>Copyright © 2025</Copyright>
    
    <!-- Application Icon -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    
    <!-- Publishing Options -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- Suppress console window -->
    <DisableWinExeOutputInference>false</DisableWinExeOutputInference>
  </PropertyGroup>

  <!-- Release-only size optimisations. Kept out of Debug so dev/build is unaffected. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- NOTE: InvariantGlobalization must stay OFF.
         WPF is not supported in globalization-invariant mode. Its font machinery
         resolves family names per culture, so laying out text in a named font
         calls CultureInfo("en-us"), which throws CultureNotFoundException when the
         switch is on. That surfaces as a "type initializer for
         MS.Internal.FontCache.MajorLanguages threw an exception" crash - and only
         in Release, which is why Debug testing never caught it (shipped broken in
         3.1.0-3.1.2; the crash needed release notes containing an inline code span
         to trigger the Consolas lookup). The few MB of ICU data are not worth it.

         NOTE: trimming is OFF.
         WPF + WinForms rely heavily on runtime reflection that the IL trimmer
         cannot prove is live, so even <TrimMode>partial</TrimMode> with the
         suppress-error flags strips types XAML loads at startup, causing the
         "An error occurred" crash. The size win is not worth the runtime risk.
         The other size optimisations below still apply and are safe. -->

    <!-- Don't emit debug/PDB data into the published output -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <!-- Drop framework satellite resources (other-language strings) -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- The test project lives under tests\ inside this project's folder, so the SDK's
       default globs would otherwise compile its sources (and xunit attributes) into
       the app. Keep it out of every glob. -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <Page Remove="tests\**" />
    <Resource Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <!-- Include Assets -->
  <ItemGroup>
    <Resource Include="Assets\app.ico" Condition="Exists('Assets\app.ico')" />
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Assets\')" />
  </ItemGroup>

</Project>
