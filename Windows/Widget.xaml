<Window x:Class="Throughput.Windows.Widget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Throughput"
        Width="250" Height="48"
        MinWidth="150" MinHeight="44"
        MaxWidth="700" MaxHeight="220"
        WindowStyle="None"
        AllowsTransparency="True"
        Foreground="White"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        FontFamily="Segoe UI"
        SizeChanged="Window_SizeChanged"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <!-- Outer grid: pill + snake-outline overlay. Margin gives the glow room. -->
    <Grid Margin="6">
        <!-- Pitch black pill, soft border + drop shadow -->
        <Border x:Name="MainBorder"
                CornerRadius="10"
                BorderThickness="1.4"
                Padding="10,6"
                Cursor="SizeAll">
            <Border.Background>
                <SolidColorBrush Color="#000000"/>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#22FFFFFF" Offset="0"/>
                    <GradientStop Color="#0AFFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>

            <Grid>
                <!--
                    The Viewbox scales the chosen layout to fill the pill.
                    Resizing the window larger -> contents (text, percentages) grow uniformly.
                    Layout-swap (wide vs narrow) is handled in code-behind by toggling
                    the Visibility of WideLayout / NarrowLayout below.
                -->
                <Viewbox Stretch="Uniform" StretchDirection="Both">
                    <Grid>
                        <!-- ============ WIDE (single-row) layout ============ -->
                        <Grid x:Name="WideLayout">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Network speeds -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="↓" FontSize="11" Foreground="#4ADE80" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <TextBlock x:Name="DownloadSpeedText" Text="0.0 KB/s"
                                           FontSize="10.5" FontWeight="SemiBold" Foreground="#86EFAC"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="↑" FontSize="11" Foreground="#F472B6" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="7,0,3,0"/>
                                <TextBlock x:Name="UploadSpeedText" Text="0.0 KB/s"
                                           FontSize="10.5" FontWeight="SemiBold" Foreground="#F9A8D4"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- CPU + RAM -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="CPU" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"
                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock x:Name="CpuText" Text="0%"
                                           FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"
                                           VerticalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect x:Name="CpuTextGlow" Color="#FACC15" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                                    </TextBlock.Effect>
                                </TextBlock>

                                <TextBlock Text="RAM" FontSize="9" FontWeight="Bold" Foreground="#FB923C"
                                           VerticalAlignment="Center" Margin="10,0,4,0"/>
                                <TextBlock x:Name="RamText" Text="0%"
                                           FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"
                                           VerticalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect x:Name="RamTextGlow" Color="#FACC15" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <!-- ============ NARROW (two-row) layout ============ -->
                        <StackPanel x:Name="NarrowLayout" Orientation="Vertical" Visibility="Collapsed">
                            <!-- Row 1: network speeds -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
                                <TextBlock Text="↓" FontSize="11" Foreground="#4ADE80" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <TextBlock x:Name="DownloadSpeedTextN" Text="0.0 KB/s"
                                           FontSize="10.5" FontWeight="SemiBold" Foreground="#86EFAC"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="↑" FontSize="11" Foreground="#F472B6" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="9,0,3,0"/>
                                <TextBlock x:Name="UploadSpeedTextN" Text="0.0 KB/s"
                                           FontSize="10.5" FontWeight="SemiBold" Foreground="#F9A8D4"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Row 2: CPU and RAM -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="CPU" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"
                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock x:Name="CpuTextN" Text="0%"
                                           FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"
                                           VerticalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect x:Name="CpuTextGlowN" Color="#FACC15" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                                    </TextBlock.Effect>
                                </TextBlock>

                                <TextBlock Text="RAM" FontSize="9" FontWeight="Bold" Foreground="#FB923C"
                                           VerticalAlignment="Center" Margin="12,0,4,0"/>
                                <TextBlock x:Name="RamTextN" Text="0%"
                                           FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"
                                           VerticalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect x:Name="RamTextGlowN" Color="#FACC15" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Viewbox>

                <!-- Close Button - only visible on hover. Outside the Viewbox so it doesn't scale. -->
                <TextBlock x:Name="CloseButton"
                           Text="✕"
                           FontSize="9"
                           Foreground="#80FFFFFF"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Margin="0,-3,-3,0"
                           Cursor="Hand"
                           Visibility="Hidden"
                           Panel.ZIndex="2"
                           MouseLeftButtonDown="CloseButton_Click"
                           ToolTip="Close widget"/>
            </Grid>
        </Border>

        <!-- Resize grips - bottom corners. Custom because AllowsTransparency
             disables WPF's native edge resize hit-testing. -->
        <Path x:Name="ResizeGripBR"
              Data="M 0,12 L 12,0 L 12,12 Z"
              Fill="#55FFFFFF"
              Width="12" Height="12"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="0,0,2,2"
              Cursor="SizeNWSE"
              Visibility="Hidden"
              Panel.ZIndex="3"
              MouseLeftButtonDown="ResizeGripBR_MouseLeftButtonDown"
              ToolTip="Drag to resize"/>
        <Path x:Name="ResizeGripBL"
              Data="M 0,0 L 12,12 L 0,12 Z"
              Fill="#55FFFFFF"
              Width="12" Height="12"
              HorizontalAlignment="Left" VerticalAlignment="Bottom"
              Margin="2,0,0,2"
              Cursor="SizeNESW"
              Visibility="Hidden"
              Panel.ZIndex="3"
              MouseLeftButtonDown="ResizeGripBL_MouseLeftButtonDown"
              ToolTip="Drag to resize"/>

        <!-- Snake outline overlay - two chasing segments, animated on warning -->
        <Rectangle x:Name="SnakeOutline"
                   Width="{Binding ActualWidth, ElementName=MainBorder}"
                   Height="{Binding ActualHeight, ElementName=MainBorder}"
                   RadiusX="10" RadiusY="10"
                   StrokeThickness="2.2"
                   Stroke="Transparent"
                   Visibility="Collapsed"
                   IsHitTestVisible="False">
            <Rectangle.Effect>
                <DropShadowEffect x:Name="SnakeGlow" Color="#FACC15" BlurRadius="10" ShadowDepth="0" Opacity="0.95"/>
            </Rectangle.Effect>
        </Rectangle>
    </Grid>
</Window>
