<Window x:Class="Throughput.Windows.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Throughput - Update"
        Width="460" Height="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        Foreground="#F6F8FE"
        FontFamily="Segoe UI"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Link-style text button -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="8" BorderBrush="#2EFFFFFF" BorderThickness="1" Background="#01000000">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <Border Grid.Row="0" Padding="18,12,12,4" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="Software Update" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                    <Border Width="30" Height="30" CornerRadius="8" Background="Transparent"
                            HorizontalAlignment="Right" Cursor="Hand"
                            MouseLeftButtonDown="Close_Click" ToolTip="Close">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- BODY -->
            <StackPanel Grid.Row="1" Margin="20,4,20,4">
                <!-- Header -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                    <Border Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4C8DFF" Offset="0"/>
                                <GradientStop Color="#2563EB" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Update Available" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="CurrentVersionText" Text="v0.0.0" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextDim}"/>
                            <TextBlock Text="  →  " FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDim}"/>
                            <TextBlock x:Name="NewVersionText" Text="v0.0.0" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource Green}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Release notes -->
                <Border Style="{StaticResource CardStyle}" Height="300" Margin="0,0,0,0">
                    <DockPanel>
                        <TextBlock x:Name="ReleaseNameText" DockPanel.Dock="Top" Text="What's new"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                   Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="NotesPanel" Margin="0,0,8,0"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- ACTIONS -->
            <Grid Grid.Row="2" Margin="20,4,20,18">
                <!-- Info actions -->
                <StackPanel x:Name="InfoActions">
                    <Button x:Name="UpdateNowButton" Content="Update Now"
                            Style="{StaticResource PrimaryButton}" Click="UpdateNow_Click"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Later" Style="{StaticResource SecondaryButton}"
                                Click="Later_Click"/>
                        <Button Grid.Column="2" Content="Skip this version" Style="{StaticResource SecondaryButton}"
                                Click="Skip_Click"/>
                    </Grid>
                    <Button Content="View on GitHub" Style="{StaticResource LinkButton}"
                            HorizontalAlignment="Center" Margin="0,8,0,0" Click="ViewOnGitHub_Click"/>
                </StackPanel>

                <!-- Download actions -->
                <StackPanel x:Name="DownloadActions" Visibility="Collapsed">
                    <TextBlock x:Name="DownloadStatusText" Text="Downloading update…" FontSize="12"
                               FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
                    <ProgressBar x:Name="DownloadProgress" Height="6" Minimum="0" Maximum="100"
                                 Background="{StaticResource TrackBg}" Foreground="{StaticResource Accent}"
                                 BorderThickness="0"/>
                    <TextBlock x:Name="DownloadPercentText" Text="0%" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextDim}" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
