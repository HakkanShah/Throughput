<Window x:Class="Throughput.Windows.MainAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Throughput - Network Dashboard"
        Width="440" Height="680"
        MinWidth="380" MinHeight="440"
        MaxWidth="600" MaxHeight="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        Foreground="#F2F4F8"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Shared palette + CardStyle/PrimaryButton/SecondaryButton live in App.xaml. -->

        <!-- ===== Window control button (min / close) ===== -->
        <Style x:Key="ChromeButton" TargetType="Border">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1EFFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== Modern slider ===== -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Background" Value="{StaticResource TrackBg}"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="6" CornerRadius="3" Background="{TemplateBinding Background}"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" CornerRadius="3"
                                                        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="18" Height="18">
                                                    <Ellipse Fill="White">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="1" Opacity="0.45"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                    <Ellipse Width="7" Height="7"
                                                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Toggle switch (styled CheckBox) ===== -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="track" Width="42" Height="24" CornerRadius="12"
                                    Background="{StaticResource TrackBg}" VerticalAlignment="Center">
                                <Ellipse x:Name="knob" Width="18" Height="18" Fill="White"
                                         HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.4"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="knob" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin scrollbar lives in App.xaml (shared). -->
    </Window.Resources>

    <!-- Root shell: background is the native acrylic backdrop; this border only
         paints the rounded glass edge highlight. -->
    <Border CornerRadius="8" BorderBrush="#2EFFFFFF" BorderThickness="1" Background="#01000000">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== TITLE BAR ===== -->
            <Border Grid.Row="0" Padding="18,14,14,12" Background="Transparent"
                    MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="9" Margin="0,0,10,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#4C8DFF" Offset="0"/>
                                        <GradientStop Color="#2563EB" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Throughput" FontSize="19" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Network Speed Monitor" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextDim}" Margin="40,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Border x:Name="MinBtn" Style="{StaticResource ChromeButton}"
                                MouseLeftButtonDown="MinimizeButton_Click" ToolTip="Minimize">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="CloseBtn" Style="{StaticResource ChromeButton}"
                                MouseLeftButtonDown="CloseButton_Click" ToolTip="Close">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== SCROLLABLE CONTENT ===== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="18,4,10,4">
                <StackPanel>

                    <!-- LIVE NETWORK SPEED -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Live Network Speed" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource Green}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Live" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Download -->
                                <Border Grid.Column="0" Background="{StaticResource InsetBg}" CornerRadius="12"
                                        BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="14,16"
                                        ToolTip="Current download speed">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border CornerRadius="9" Width="30" Height="30" Margin="0,0,10,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#0C3D30" Offset="0"/>
                                                        <GradientStop Color="#0A4A38" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="↓" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Green}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Download" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="LiveDownloadSpeed" Text="0 KB/s" FontSize="21" FontWeight="Bold"
                                                   Foreground="{StaticResource Green}" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Upload -->
                                <Border Grid.Column="2" Background="{StaticResource InsetBg}" CornerRadius="12"
                                        BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="14,16"
                                        ToolTip="Current upload speed">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border CornerRadius="9" Width="30" Height="30" Margin="0,0,10,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#4A1130" Offset="0"/>
                                                        <GradientStop Color="#5A153A" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="↑" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Rose}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Upload" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="LiveUploadSpeed" Text="0 KB/s" FontSize="21" FontWeight="Bold"
                                                   Foreground="{StaticResource Rose}" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- SPEED TEST -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Internet Speed Test" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TestStatusText" Text="Measure your maximum internet bandwidth"
                                       FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"
                                       TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <Button x:Name="SpeedTestButton" Content="⚡ Test My Internet Speed"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="SpeedTestButton_Click"
                                    ToolTip="Measure your internet connection speed and latency"/>

                            <ProgressBar x:Name="TestProgressBar" Height="4" Margin="0,14,0,0"
                                         Background="{StaticResource TrackBg}" Foreground="{StaticResource Accent}"
                                         BorderThickness="0" Visibility="Collapsed"/>

                            <!-- Results -->
                            <Border x:Name="ResultsGrid" Margin="0,16,0,0" Visibility="Collapsed"
                                    Background="{StaticResource InsetBg}" CornerRadius="12"
                                    BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="4,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Ping" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                            <TextBlock x:Name="ResultLatency" Text="0" FontSize="19" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Bottom"/>
                                            <TextBlock Text="ms" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextDim}" VerticalAlignment="Bottom" Margin="3,0,0,3"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource Stroke}" Margin="0,2"/>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Download" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="ResultDownload" Text="0" FontSize="19" FontWeight="Bold"
                                                   Foreground="{StaticResource Green}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="ResultDownloadMB" Text="≈ 0.0 MB/s" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Rectangle Grid.Column="3" Width="1" Fill="{StaticResource Stroke}" Margin="0,2"/>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Upload" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="ResultUpload" Text="0" FontSize="19" FontWeight="Bold"
                                                   Foreground="{StaticResource Rose}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="ResultUploadMB" Text="≈ 0.0 MB/s" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- WIDGET -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <TextBlock Text="Desktop Widget" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Ellipse x:Name="WidgetStatusDot" Width="7" Height="7"
                                             Fill="{StaticResource TextDim}" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="WidgetStatusText" Text="Widget is hidden"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <Button x:Name="LaunchWidgetButton" Content="Launch Widget"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="LaunchWidgetButton_Click"
                                    ToolTip="Show the floating widget on your desktop"/>
                        </StackPanel>
                    </Border>

                    <!-- BORDER WARNING ANIMATION -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Border Warning Animation" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <CheckBox x:Name="AnimationEnabledCheckBox" Style="{StaticResource ToggleSwitch}"
                                          HorizontalAlignment="Right"
                                          Checked="AnimationEnabledCheckBox_CheckedChanged"
                                          Unchecked="AnimationEnabledCheckBox_CheckedChanged"/>
                            </Grid>
                            <TextBlock Text="The widget border glows when CPU or RAM usage crosses these levels."
                                       FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"
                                       TextWrapping="Wrap" Margin="0,0,0,18"/>

                            <!-- Warning threshold -->
                            <Grid Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource Yellow}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Warning threshold" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="WarningValueText" Text="75%" FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource Yellow}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="WarningSlider" Style="{StaticResource ModernSlider}"
                                    Foreground="{StaticResource Yellow}"
                                    Minimum="1" Maximum="99" IsSnapToTickEnabled="True" TickFrequency="1"
                                    Margin="0,6,0,18" ValueChanged="WarningSlider_ValueChanged"/>

                            <!-- Critical threshold -->
                            <Grid Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource Red}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Critical threshold" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="CriticalValueText" Text="90%" FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource Red}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="CriticalSlider" Style="{StaticResource ModernSlider}"
                                    Foreground="{StaticResource Red}"
                                    Minimum="2" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1"
                                    Margin="0,6,0,20" ValueChanged="CriticalSlider_ValueChanged"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="AnimationSavedText" Grid.Column="0" Text=""
                                           FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Green}"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="SaveAnimationButton" Grid.Column="1" Content="Save Settings"
                                        Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                                        Padding="22,10" Click="SaveAnimationButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ===== FOOTER ===== -->
            <Border Grid.Row="2" Padding="18,10,18,12" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock VerticalAlignment="Center" Cursor="Hand"
                               MouseLeftButtonDown="OpenHakkanLink_Click"
                               ToolTip="Visit Developer's Portfolio">
                        <Run Text="Crafted by " FontSize="11" Foreground="{StaticResource TextDim}"/>
                        <Run Text="Hakkan" FontSize="11" TextDecorations="Underline"
                             FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Update-available pill (shown when a newer release is known) -->
                        <Border x:Name="UpdatePill" Visibility="Collapsed" Cursor="Hand"
                                Background="#223DDCA4" BorderBrush="#553DDCA4" BorderThickness="1"
                                CornerRadius="10" Padding="10,4" Margin="0,0,10,0"
                                MouseLeftButtonDown="UpdatePill_Click" ToolTip="A new version is available">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Green}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Update available" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource Green}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Manual check link (shown when no update is known) -->
                        <TextBlock x:Name="CheckUpdatesLink" Text="Check for updates" Cursor="Hand"
                                   FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"
                                   TextDecorations="Underline" VerticalAlignment="Center" Margin="0,0,12,0"
                                   MouseLeftButtonDown="CheckUpdates_Click"/>

                        <TextBlock x:Name="VersionText" Text="v0.0.0" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
